{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dspf-rad.example/contracts/runtime-binding.schema.json",
  "title": "External Runtime Display Binding",
  "type": "object",
  "required": ["sourceIdentity", "runtimeSource", "role", "status"],
  "properties": {
    "sourceIdentity": { "type": "string" },
    "runtimeSource": { "type": "string" },
    "sourceLocation": { "type": ["string", "null"] },
    "role": { "type": "string", "enum": ["display-value", "hidden-control", "indicator", "message", "workflow-hint", "unknown"] },
    "value": {},
    "workflowHint": { "type": ["string", "null"] },
    "status": { "type": "string", "enum": ["converted", "converted-with-warning", "manual-review", "unsupported", "error"] },
    "reason": { "type": ["string", "null"] }
  },
  "additionalProperties": false
}
